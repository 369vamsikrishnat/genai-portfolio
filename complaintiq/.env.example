# Reference environment values. Load through your shell or secret manager; never commit real secrets.
CIQ_DATA_DIR=data
CIQ_ARTIFACTS_DIR=artifacts
CIQ_RESULTS_DIR=results
CIQ_DOCS_DIR=docs
CIQ_DOCKER_EXTRAS=data,serve  # compose image extras; add ,embed for transformer models

CIQ_EMBEDDER=hashing          # hashing (offline demo) | bge-small (requires .[embed])
CIQ_RERANKER=lexical          # lexical | none | cross-encoder (requires .[embed])

CIQ_LLM=mock                  # mock | ollama | gemini
CIQ_OLLAMA_URL=http://localhost:11434
CIQ_OLLAMA_MODEL=qwen2.5:7b   # install separately: ollama pull qwen2.5:7b
CIQ_GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=

CIQ_API_KEY=                  # empty disables API-key authentication; local development only
CIQ_RATE_LIMIT=60
CIQ_LLM_THRESHOLD=0.70
CIQ_MIN_DENSE_SCORE=0.20
CIQ_MAX_CHARS=2000

# Placeholder prices used only for estimated costs; verify provider prices before use.
CIQ_PRICE_IN_PER_M=0.25
CIQ_PRICE_OUT_PER_M=1.50
