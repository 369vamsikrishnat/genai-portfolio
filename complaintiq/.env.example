# Copy to .env and `export $(cat .env | xargs)` (or use direnv). Everything has a safe default.
CIQ_LLM=mock                 # mock | ollama | gemini
CIQ_OLLAMA_MODEL=qwen2.5:7b  # `ollama pull qwen2.5:7b`
CIQ_GEMINI_MODEL=gemini-flash-latest   # check Google AI Studio for current model names
GEMINI_API_KEY=
CIQ_EMBEDDER=hashing         # hashing (offline demo) | bge-small (real, needs .[embed])
CIQ_RERANKER=lexical         # lexical (demo) | cross-encoder (real) | none
CIQ_API_KEY=                 # set to require X-API-Key on the API
CIQ_RATE_LIMIT=60
CIQ_LLM_THRESHOLD=0.70
# List prices used ONLY for the estimated cost table; check the provider's pricing page.
CIQ_PRICE_IN_PER_M=0.75
CIQ_PRICE_OUT_PER_M=3.75
