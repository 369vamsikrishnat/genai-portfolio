            "No indexed chunks found."
        )

    print(
        f"Indexed chunks: {len(chunks)}"
    )

    print("\nBuilding retrieval resources...")

    bm25 = build_bm25(chunks)

    reranker = load_reranker()

    # ------------------------------------------------------------------
    # Storage
    # ------------------------------------------------------------------

    all_case_results = []

    total_latency = {
        "dense": 0.0,
